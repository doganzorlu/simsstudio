<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SimsConverter.App.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="SimsConverter.App.MainWindow"
        x:DataType="vm:ResourceInspectorViewModel"
        Title="SIMSStudio — Package &amp; Sims3Pack Inspector &amp; Exporter"
        Width="1000" Height="600">
    <DockPanel Margin="16">
        <!-- Header -->
        <TextBlock DockPanel.Dock="Top" Text="Package &amp; Sims3Pack Inspector &amp; Raw Exporter" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <!-- File Selection & Action Panel -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*, Auto, Auto, Auto, Auto, Auto" RowDefinitions="Auto, Auto, Auto" Margin="0,0,0,12">
            <!-- Row 0: Input file & inspect -->
            <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding SelectedFilePath}" PlaceholderText="Enter or select .package or .sims3pack file path..." Margin="0,0,8,4"/>
            <Button Grid.Row="0" Grid.Column="1" Command="{Binding BrowseCommand}" Content="Browse Source..." Margin="0,0,8,4"/>
            <Button Grid.Row="0" Grid.Column="2" Command="{Binding InspectCommand}" Content="Inspect File" Margin="0,0,8,4"/>
            <CheckBox Grid.Row="0" Grid.Column="3" IsChecked="{Binding AllowOverwrite}" Content="Overwrite Existing" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <Button Grid.Row="0" Grid.Column="4" Command="{Binding ExportResourceCommand}" Content="Export Selected Raw Resource" IsVisible="{Binding !IsSims3PackMode}" Margin="0,0,0,4"/>
            <Button Grid.Row="0" Grid.Column="5" Command="{Binding ExportSims3PackPayloadCommand}" Content="Export .package Payload" IsVisible="{Binding IsSims3PackMode}" Margin="0,0,0,4"/>

            <!-- Row 1: Target Output path, Direction Selector & Convert action -->
            <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding TargetOutputPath}" PlaceholderText="Target .package output path..." Margin="0,4,8,0"/>
            <Button Grid.Row="1" Grid.Column="1" Command="{Binding BrowseTargetOutputCommand}" Content="Browse Target..." Margin="0,4,8,0"/>
            <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding TargetGameVersionOptions}" SelectedItem="{Binding SelectedTargetGameVersionOption}" Margin="0,4,8,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Row="1" Grid.Column="3" Command="{Binding ConvertCommand}" Content="{Binding ConvertButtonContent}" Margin="0,4,8,0"/>
            <Button Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" Command="{Binding InspectConvertedPackageCommand}" Content="Inspect Output Package in UI" Margin="0,4,0,0" IsVisible="{Binding CanInspectConvertedPackage}"/>

            <ProgressBar Grid.Row="2" Grid.ColumnSpan="6" IsVisible="{Binding IsBusy}" IsIndeterminate="True" Margin="0,8,0,0"/>
        </Grid>

        <!-- Status Bar -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,12"/>

        <!-- Package Classification & Multi-Item Selector Panel (Visible when HasPackageClassification is true) -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding HasPackageClassification}"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto">
                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Package Mode:" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="{Binding PackageClassificationText}" FontSize="14" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="Discovered Package Items (Multi-Item Routing):" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,2"/>
                    <ComboBox ItemsSource="{Binding PackageItems}" SelectedItem="{Binding SelectedPackageItem}" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding ItemTitle}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Category, StringFormat='[{0}]'}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    <TextBlock Text="{Binding MeshCount, StringFormat='Meshes: {0}'}" FontSize="11"/>
                                    <TextBlock Text="{Binding TextureCount, StringFormat='Textures: {0}'}" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Vertical" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Selected Item ID:" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="{Binding SelectedPackageItem.ItemId, FallbackValue='N/A'}" FontSize="12" FontFamily="Monospace" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sims3Pack Metadata Panel (Visible when IsSims3PackMode is true) -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding IsSims3PackMode}"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,12">
            <Grid ColumnDefinitions="*, *, *" RowDefinitions="Auto, Auto">
                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,8,4">
                    <TextBlock Text="Title:" FontWeight="SemiBold" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="{Binding Sims3PackTitle, FallbackValue='N/A'}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,8,4">
                    <TextBlock Text="Asset ID:" FontWeight="SemiBold" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="{Binding Sims3PackAssetId, FallbackValue='N/A'}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="Asset Type:" FontWeight="SemiBold" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="{Binding Sims3PackAssetType, FallbackValue='N/A'}"/>
                </StackPanel>
                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,4,8,0">
                    <TextBlock Text="Root Element:" FontWeight="SemiBold" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="{Binding Sims3PackRootElement, FallbackValue='N/A'}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,4,8,0">
                    <TextBlock Text="Encoding:" FontWeight="SemiBold" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="{Binding Sims3PackEncoding, FallbackValue='N/A'}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,4,0,0">
                    <TextBlock Text="XML Size:" FontWeight="SemiBold" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="{Binding Sims3PackXmlSize, FallbackValue='N/A'}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Diagnostic Issues Section (Visible when HasIssues is true) -->
        <Border DockPanel.Dock="Bottom"
                IsVisible="{Binding HasIssues}"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                BorderBrush="{DynamicResource SystemControlErrorTextForegroundBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8"
                Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Diagnostic Issues Reported:" FontWeight="SemiBold" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" Margin="0,0,0,4"/>
                <ListBox ItemsSource="{Binding Issues}" MaxHeight="100">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Code}" FontWeight="Bold" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"/>
                                <TextBlock Text="{Binding Severity, StringFormat='[{0}]'}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                <TextBlock Text="{Binding Message}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Inspection Content Tabs -->
        <TabControl>
            <TabItem Header="Package Resources" IsVisible="{Binding !IsSims3PackMode}">
                <DataGrid ItemsSource="{Binding Resources}"
                          SelectedItem="{Binding SelectedResource}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="All"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Formatted Key" Binding="{Binding FormattedKey}" CellStyleClasses="monospaced" Width="2*"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding TypeHex}" CellStyleClasses="monospaced" Width="*"/>
                        <DataGridTextColumn Header="Group" Binding="{Binding GroupHex}" CellStyleClasses="monospaced" Width="*"/>
                        <DataGridTextColumn Header="Instance" Binding="{Binding InstanceHex}" CellStyleClasses="monospaced" Width="1.5*"/>
                        <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="*"/>
                        <DataGridTextColumn Header="Size (B)" Binding="{Binding CompressedSize}" Width="*"/>
                        <DataGridTextColumn Header="Decomp (B)" Binding="{Binding DecompressedSize}" Width="*"/>
                        <DataGridTextColumn Header="Compression" Binding="{Binding CompressionName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Texture Candidates" IsVisible="{Binding !IsSims3PackMode}">
                <DataGrid ItemsSource="{Binding TextureResources}"
                          SelectedItem="{Binding SelectedTextureResource}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="All"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Formatted Key" Binding="{Binding FormattedKey}" CellStyleClasses="monospaced" Width="2*"/>
                        <DataGridTextColumn Header="Format Name" Binding="{Binding FormatName}" Width="1.5*"/>
                        <DataGridTextColumn Header="Map Kind" Binding="{Binding MapKind}" Width="*"/>
                        <DataGridTextColumn Header="Game Version" Binding="{Binding DetectedGameVersion}" Width="*"/>
                        <DataGridTextColumn Header="Can Extract" Binding="{Binding CanExtractRawPayload}" Width="*"/>
                        <DataGridTextColumn Header="DDS Header Capable" Binding="{Binding CanParseDdsHeader}" Width="1.2*"/>
                        <DataGridTextColumn Header="Issues" Binding="{Binding Issues.Count}" Width="0.8*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Mesh Candidates" IsVisible="{Binding !IsSims3PackMode}">
                <DataGrid ItemsSource="{Binding MeshResources}"
                          SelectedItem="{Binding SelectedMeshResource}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="All"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Formatted Key" Binding="{Binding FormattedKey}" CellStyleClasses="monospaced" Width="2*"/>
                        <DataGridTextColumn Header="Format Name" Binding="{Binding FormatName}" Width="1.2*"/>
                        <DataGridTextColumn Header="Role" Binding="{Binding RoleKind}" Width="*"/>
                        <DataGridTextColumn Header="Game Version" Binding="{Binding DetectedGameVersion}" Width="*"/>
                        <DataGridTextColumn Header="Can Extract" Binding="{Binding CanExtractRawPayload}" Width="*"/>
                        <DataGridTextColumn Header="Can Inspect" Binding="{Binding CanInspectCanonicalMesh}" Width="*"/>
                        <DataGridTextColumn Header="Vertices" Binding="{Binding VertexCount}" Width="0.8*"/>
                        <DataGridTextColumn Header="Faces" Binding="{Binding FaceCount}" Width="0.8*"/>
                        <DataGridTextColumn Header="Bones" Binding="{Binding BoneCount}" Width="0.8*"/>
                        <DataGridTextColumn Header="Normals" Binding="{Binding HasNormals}" Width="0.8*"/>
                        <DataGridTextColumn Header="UV0" Binding="{Binding HasUv0}" Width="0.8*"/>
                        <DataGridTextColumn Header="Weights" Binding="{Binding HasBoneWeights}" Width="0.8*"/>
                        <DataGridTextColumn Header="Issues" Binding="{Binding Issues.Count}" Width="0.8*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Embedded Payloads" IsVisible="{Binding IsSims3PackMode}">
                <DataGrid ItemsSource="{Binding Sims3PackPayloads}"
                          SelectedItem="{Binding SelectedSims3PackPayload}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="All"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding EntryIndex}" Width="0.5*"/>
                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="*"/>
                        <DataGridTextColumn Header="Offset" Binding="{Binding DataOffsetHex}" CellStyleClasses="monospaced" Width="1.5*"/>
                        <DataGridTextColumn Header="Estimated Size" Binding="{Binding EstimatedSizeFormatted}" Width="1.2*"/>
                        <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="2*"/>
                        <DataGridTextColumn Header="Exportable" Binding="{Binding CanExport}" Width="*"/>
                        <DataGridTextColumn Header="Issues" Binding="{Binding Issues.Count}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Conversion &amp; Output Summary">
                <DockPanel Margin="8">
                    <!-- Banner Summary Card -->
                    <Border DockPanel.Dock="Top"
                            IsVisible="{Binding HasConversionResult}"
                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                            <StackPanel Grid.Column="0" Grid.Row="0">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                    <TextBlock Text="Conversion Status:" FontWeight="Bold"/>
                                    <TextBlock Text="SUCCESS" FontWeight="Bold" Foreground="Green" IsVisible="{Binding IsConversionSuccess}"/>
                                    <TextBlock Text="FAILED" FontWeight="Bold" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" IsVisible="{Binding !IsConversionSuccess}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding LastConvertedPackagePath, StringFormat='Output Package: {0}'}" IsVisible="{Binding IsConversionSuccess}" FontSize="12"/>
                            </StackPanel>

                            <Button Grid.Column="1" Grid.Row="0" Command="{Binding InspectConvertedPackageCommand}" Content="Inspect Output Package in UI" IsVisible="{Binding CanInspectConvertedPackage}" VerticalAlignment="Center"/>

                            <Grid Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" ColumnDefinitions="*, *, *, *, *, *, *" Margin="0,12,0,0" IsVisible="{Binding IsConversionSuccess}">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Total Resources" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    <TextBlock Text="{Binding ConversionTotalResourceCount}" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Verified Links" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    <TextBlock Text="{Binding ConversionVerifiedLinkCount}" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Meshes" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    <TextBlock Text="{Binding ConversionMeshCount}" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Textures" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    <TextBlock Text="{Binding ConversionTextureCount}" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="RIG" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    <TextBlock Text="{Binding ConversionRigCount}" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="5">
                                    <TextBlock Text="RSLT" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    <TextBlock Text="{Binding ConversionRsltCount}" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Payload Bytes" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                    <TextBlock Text="{Binding ConversionTotalPayloadBytes}" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid RowDefinitions="*, *">
                        <!-- Conversion Execution Steps DataGrid -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Top" Text="Conversion Execution Pipeline Steps:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <DataGrid ItemsSource="{Binding ConversionSteps}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="All"
                                      BorderThickness="1"
                                      BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Step ID" Binding="{Binding StepId}" CellStyleClasses="monospaced" Width="1.5*"/>
                                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                                    <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="3*"/>
                                    <DataGridTextColumn Header="Issues" Binding="{Binding Issues.Count}" Width="0.8*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <!-- Verified TGI Graph Links DataGrid -->
                        <DockPanel Grid.Row="1">
                            <TextBlock DockPanel.Dock="Top" Text="Verified TGI Graph Links:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <DataGrid ItemsSource="{Binding ConversionResourceLinks}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="All"
                                      BorderThickness="1"
                                      BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Source Key" Binding="{Binding SourceKey}" CellStyleClasses="monospaced" Width="2*"/>
                                    <DataGridTextColumn Header="Relationship Type" Binding="{Binding RelationshipType}" Width="1.5*"/>
                                    <DataGridTextColumn Header="Target Key" Binding="{Binding TargetKey}" CellStyleClasses="monospaced" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Capability Matrix Surface" IsVisible="{Binding HasCapabilityMatrix}">
                <DockPanel Margin="8">
                    <!-- Summary Card Header -->
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*, *, *, *" RowDefinitions="Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Direction" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                <TextBlock Text="{Binding ConversionDirectionText}" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Supported Resources" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                <TextBlock Text="{Binding CapabilitySupportedCount}" FontSize="16" FontWeight="Bold" Foreground="Green"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PassThrough Resources" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                <TextBlock Text="{Binding CapabilityPassThroughCount}" FontSize="16" FontWeight="Bold" Foreground="Blue"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Unsupported Resources" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                <TextBlock Text="{Binding CapabilityUnsupportedCount}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid RowDefinitions="*, Auto">
                        <!-- Capability Entries Table -->
                        <DataGrid Grid.Row="0"
                                  ItemsSource="{Binding CapabilityEntries}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="All"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Type ID" Binding="{Binding TypeId, StringFormat='0x{0:X8}'}" CellStyleClasses="monospaced" Width="1.2*"/>
                                <DataGridTextColumn Header="Resource Type Name" Binding="{Binding TypeName}" Width="2*"/>
                                <DataGridTextColumn Header="Capability Status" Binding="{Binding CapabilityStatus}" Width="1.2*"/>
                                <DataGridTextColumn Header="Count" Binding="{Binding ResourceCount}" Width="0.8*"/>
                                <DataGridTextColumn Header="Handling Strategy / Note" Binding="{Binding Note}" Width="3*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Capability Warnings Section (CAPA001 / CAPA002) -->
                        <Border Grid.Row="1"
                                IsVisible="{Binding HasCapabilityWarnings}"
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                BorderBrush="{DynamicResource SystemControlErrorTextForegroundBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8"
                                Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Capability Warnings &amp; Omissions (CAPA001 / CAPA002):" FontWeight="SemiBold" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" Margin="0,0,0,4"/>
                                <ListBox ItemsSource="{Binding CapabilityWarnings}" MaxHeight="90">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Code}" FontWeight="Bold" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"/>
                                                <TextBlock Text="{Binding Message}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Folder Batch Conversion">
                <DockPanel Margin="8">
                    <!-- Batch Top Toolbar & Folder Selection -->
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*, Auto, Auto, Auto" RowDefinitions="Auto, Auto, Auto, Auto, Auto">
                            <!-- OS Selection Guidance Banner -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                                       Text="💡 Folder Selection Guide: macOS users: highlight or open folder and click 'Open'. Windows users: click 'Select Folder'."
                                       FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       Margin="0,0,0,8" TextWrapping="Wrap"/>

                            <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding BatchSourceFolderPath}" PlaceholderText="Select folder containing .package and .sims3pack files..." Margin="0,0,8,4"/>
                            <Button Grid.Row="1" Grid.Column="1" Command="{Binding BrowseFolderCommand}" Content="Select Source Folder..." ToolTip.Tip="Open native picker with title 'Select Source Folder'" Margin="0,0,8,4"/>
                            <Button Grid.Row="1" Grid.Column="2" Command="{Binding ScanBatchFolderCommand}" Content="Scan Folder" Margin="0,0,8,4"/>
                            <Button Grid.Row="1" Grid.Column="3" Command="{Binding ConvertBatchCommand}" Content="Convert Batch" FontWeight="Bold" Margin="0,0,0,4"/>

                            <TextBox Grid.Row="2" Grid.Column="0" Text="{Binding BatchOutputFolderPath}" PlaceholderText="Output destination folder (defaults to source folder)..." Margin="0,4,8,4"/>
                            <Button Grid.Row="2" Grid.Column="1" Command="{Binding BrowseBatchOutputFolderCommand}" Content="Select Target Output Folder..." ToolTip.Tip="Open native picker with title 'Select Target Output Folder'" Margin="0,4,8,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding BatchProgressText}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="8,4,0,4"/>

                            <!-- Selected Folder Path Summary Banner -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                <TextBlock Text="{Binding BatchSourceFolderPath, StringFormat='Source Path: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                <TextBlock Text="{Binding BatchOutputFolderPath, StringFormat='Target Path: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>

                            <!-- Batch Diagnostic Log Actions & Status Bar -->
                            <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" ColumnDefinitions="*, Auto, Auto" Margin="0,8,0,0" IsVisible="{Binding HasBatchLog}">
                                <TextBlock Grid.Column="0" Text="{Binding BatchLogStatusMessage}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Command="{Binding OpenLastBatchLogCommand}" Content="Open Last Batch Log" Margin="8,0,8,0"/>
                                <Button Grid.Column="2" Command="{Binding CopyLogPathCommand}" Content="Copy Log Path"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Batch Summary Dashboard Cards -->
                    <Border DockPanel.Dock="Top"
                            IsVisible="{Binding HasBatchItems}"
                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*, *, *, *, *, *" RowDefinitions="Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Total Files" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                <TextBlock Text="{Binding BatchTotalCount}" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Successful" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                <TextBlock Text="{Binding BatchSuccessCount}" FontSize="18" FontWeight="Bold" Foreground="Green"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Failed" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                <TextBlock Text="{Binding BatchFailedCount}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Skipped" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                <TextBlock Text="{Binding BatchSkippedCount}" FontSize="18" FontWeight="Bold" Foreground="Orange"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Ignored / Standalone" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                <TextBlock Text="{Binding BatchIgnoredCount}" FontSize="18" FontWeight="Bold" Foreground="Gray"/>
                            </StackPanel>
                            <StackPanel Grid.Column="5">
                                <TextBlock Text="Pending" FontSize="11" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                <TextBlock Text="{Binding BatchPendingCount}" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Batch Results DataGrid -->
                    <DataGrid ItemsSource="{Binding BatchItems}"
                              SelectedItem="{Binding SelectedBatchItem}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="All"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="2*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1.2*"/>
                            <DataGridTextColumn Header="Direction" Binding="{Binding DirectionText}" Width="*"/>
                            <DataGridTextColumn Header="Target Path" Binding="{Binding TargetOutputPath}" CellStyleClasses="monospaced" Width="2.5*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                            <DataGridTextColumn Header="Status / Diagnostics" Binding="{Binding StatusMessage}" Width="3*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
